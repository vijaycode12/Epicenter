FROM python:3.11-slim

# Hugging Face Spaces requires the app to listen on port 7860, and only
# /tmp is genuinely writable at runtime - both Ultralytics and
# transformers/huggingface_hub need to be told to cache there instead
# of their normal default locations, or they'll fail with permission
# errors the same way we saw on Render ("user config directory is not
# writable").
ENV YOLO_CONFIG_DIR=/tmp/Ultralytics
ENV HF_HOME=/tmp/huggingface
ENV TRANSFORMERS_CACHE=/tmp/huggingface

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Give the (default, non-root) user write access to /tmp explicitly -
# HF Spaces containers run as a non-root user by default.
RUN mkdir -p /tmp/Ultralytics /tmp/huggingface && chmod -R 777 /tmp

EXPOSE 7860

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "7860"]